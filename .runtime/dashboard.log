  26 |   return <div className="app-shell"><aside className={`sidebar ${mobileNav?'sidebar-open':''}`}><Brand/><div className="workspace-label">{teacher?'TEACHER WORKSPACE':'STUDENT WORKSPACE'}</div><nav aria-label="Main navigation">{[{id:'overview',icon:LayoutDashboard,label:'Overview'},{id:'sessions',icon:Radio,label:teacher?'My sessions':'My classes'},{id:'reports',icon:ClipboardList,label:teacher?'Session reports':'My history'},{id:'guide',icon:BookOpen,label:'Getting started'}].map(({id,icon:Icon,label})=><button key={id} className={page===id&&!roomId?'active':''} onClick={()=>navigate(id)}><Icon size={19}/>{label}{id==='sessions'&&<span className="nav-count">{sessions.filter(s=>s.status==='live').length}</span>}</button>)}</nav><div className="sidebar-bottom"><div className="privacy-card"><span className="privacy-mark"><ShieldCheck size={21}/></span><strong>Presence, with privacy.</strong><p>No cameras. No screen tracking. Just meaningful participation.</p></div><button className="settings-link" onClick={()=>navigate('settings')}><Settings size={18}/>Account & setup</button><div className="profile"><span className="avatar">{user.name.split(' ').slice(0,2).map(n=>n[0]).join('')}</span><div><strong>{user.name}</strong><small>{teacher?'Teacher':'Student'}</small></div><Button variant="ghost" size="icon" aria-label="Sign out" onClick={logout}><LogOut size={17}/></Button></div></div></aside><div className="main-shell"><header className="topbar"><div className="row"><Button variant="ghost" size="icon" className="mobile-menu" aria-label="Toggle navigation" onClick={()=>setMobileNav(!mobileNav)}>{mobileNav?<X size={20}/>:<Menu size={20}/>}</Button><span className="breadcrumb">Workspace <span>/</span> {roomId?'Session room':page==='overview'?'Overview':page==='sessions'?'Sessions':page==='reports'?'Reports':page==='guide'?'Getting started':'Account & setup'}</span></div><div className="topbar-right"><span className="camera-free"><ShieldCheck size={15}/>Camera-free by design</span><span className="topbar-avatar">{firstName[0]}</span></div></header><main><Notice text={error}/>{roomId?(teacher?<TeacherRoom id={roomId} onBack={()=>navigate('sessions')}/>:<StudentRoom id={roomId}/>):page==='guide'?<Guide/>:page==='settings'?<SettingsPage user={user}/>:<><header className="page-heading"><div><span className="eyebrow">{page==='overview'?'A GOOD DAY TO CONNECT':page==='reports'?'THE BIGGER PICTURE':'YOUR CLASSROOMS'}</span><h1>{page==='overview'?`Hello, ${firstName}.`:page==='reports'?(teacher?'Session reports':'Your participation history'):(teacher?'My sessions':'My classes')}</h1><p className="muted">{page==='overview'?'A clearer view of who’s taking part.':page==='reports'?'Every question and response, with the context that matters.':'Make space for a little more participation.'}</p></div>{teacher&&page!=='reports'&&<Button onClick={()=>setCreate(true)}><Plus size={18}/>Create session</Button>}</header>{page==='overview'&&<><section className="welcome-banner"><div><Badge tone="light"><Radio size={13}/>MORE CONNECTION, LESS GUESSWORK</Badge><h2>{teacher?'Bring everyone into the conversation.':'A small answer makes a difference.'}</h2><p>{teacher?'Start a class, send a thoughtful question, and see your classroom come together.':'Join your class and share what you’re thinking. Your next question is just a moment away.'}</p>{teacher?<Button variant="secondary" onClick={()=>setCreate(true)}>Start something good <ArrowRight size={17}/></Button>:<Button variant="secondary" onClick={()=>document.querySelector<HTMLInputElement>('.code-input')?.focus()}>Join your classroom <ArrowRight size={17}/></Button>}</div><div className="banner-art" aria-hidden="true"><span className="orbit one"/><span className="orbit two"/><span className="art-center"><Radio size={40}/></span><span className="art-small a"><MessageIcon/></span><span className="art-small b"><CheckCircle2 size={23}/></span><span className="art-small c"><Users size={23}/></span></div></section><div className="overview-metrics"><div><span className="mini-metric-icon"><Radio size={21}/></span><div><strong>{sessions.filter(s=>s.status==='live').length}</strong><span>Live sessions</span></div></div><div><span className="mini-metric-icon"><GraduationCap size={22}/></span><div><strong>{sessions.length}</strong><span>{teacher?'Sessions created':'Classes joined'}</span></div></div><div><span className="mini-metric-icon"><ClipboardList size={21}/></span><div><strong>{sessions.filter(s=>s.status==='ended').length}</strong><span>Completed sessions</span></div></div></div></>}{!teacher&&page!=='reports'&&<ClassDirectory onJoined={r=>open(r.id)}/><JoinForm onJoined={r=>open(r.id)}/>}<section className="sessions-section"><div className="section-heading"><div><h2>{page==='reports'?'Completed sessions':page==='overview'?'Your sessions':'All sessions'}</h2><p className="muted small">{page==='reports'?'Open a session to review answers and missed-response reasons.':'Pick up where you left off, or start a new conversation.'}</p></div>{page==='overview'&&<Button variant="ghost" onClick={()=>navigate('sessions')}>View all sessions <ArrowUpRight size={16}/></Button>}</div>{sessions.filter(s=>page!=='reports'||s.status==='ended').length?<div className="session-grid">{sessions.filter(s=>page!=='reports'||s.status==='ended').map(s=><button className="session-card" key={s.id} onClick={()=>open(s.id)}><div className="row-between"><span className="session-course-icon"><GraduationCap size={21}/></span><Status status={s.status}/></div><p className="eyebrow">{s.course||'CLASSROOM'}</p><h3>{s.title}</h3><p className="session-card-date">{formatDate(s.created_at)}</p><div className="session-card-footer"><span><Users size={15}/>{s.members} students</span><span>{s.questions} questions</span><ArrowUpRight size={18}/></div></button>)}</div>:<section className="card"><Empty title={page==='reports'?'A fresh chapter.':'Your next class starts here.'} detail={page==='reports'?'Completed session